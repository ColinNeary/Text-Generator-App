<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<!-- Written by Raghav Mukundan, rxm210068 -->
<!-- Sentence Generation interface with Greedy and Beam Search algorithms -->

<VBox fx:id="root"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.javafxproject.SentenceGenerationController"
      alignment="TOP_CENTER"
      spacing="20"
      prefWidth="1200"
      prefHeight="750"
      style="-fx-padding: 30 50 30 50; -fx-background-color: #0f172a;">

    <!-- Header Section -->
    <VBox alignment="CENTER" spacing="5">
        <Label text="📝 Sentence Generation"
               style="-fx-font-size: 26px;
                      -fx-text-fill: #f8fafc;
                      -fx-font-weight: bold;
                      -fx-font-family: 'Segoe UI', 'System', sans-serif;" />
        <Label text="Generate complete sentences using Greedy or Beam Search algorithms"
               style="-fx-font-size: 14px;
                      -fx-text-fill: #94a3b8;
                      -fx-font-family: 'Segoe UI', 'System', sans-serif;" />
    </VBox>

    <!-- Starting Word Input -->
    <VBox style="-fx-background-color: #1e293b;
                 -fx-background-radius: 12;
                 -fx-padding: 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0.15, 0, 5);"
          spacing="15"
          prefWidth="900">

        <Label text="🎯 Starting Word"
               style="-fx-font-size: 16px;
                      -fx-text-fill: #f8fafc;
                      -fx-font-weight: bold;" />

        <TextField fx:id="startingWordField"
                   promptText="Enter a starting word..."
                   style="-fx-background-color: #334155;
                          -fx-background-radius: 8;
                          -fx-border-color: #475569;
                          -fx-border-radius: 8;
                          -fx-border-width: 1;
                          -fx-text-fill: #f1f5f9;
                          -fx-font-size: 15px;
                          -fx-padding: 12;" />

        <!-- Algorithm Selection Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="greedyButton" text="🎯 Generate with Greedy" onAction="#generateGreedy"
                    style="-fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #ffffff;
                           -fx-background-color: #f59e0b;
                           -fx-background-radius: 8;
                           -fx-padding: 14 28;
                           -fx-cursor: hand;" />
            <Button fx:id="beamSearchButton" text="🔍 Generate with Beam Search" onAction="#generateBeamSearch"
                    style="-fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #ffffff;
                           -fx-background-color: #3b82f6;
                           -fx-background-radius: 8;
                           -fx-padding: 14 28;
                           -fx-cursor: hand;" />
            <Button fx:id="resetButton" text="🔄 Reset" onAction="#reset"
                    style="-fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #f8fafc;
                           -fx-background-color: #64748b;
                           -fx-background-radius: 8;
                           -fx-padding: 14 28;
                           -fx-cursor: hand;" />
        </HBox>
    </VBox>

    <!-- Generated Sentence Display -->
    <VBox style="-fx-background-color: #1e293b;
                 -fx-background-radius: 12;
                 -fx-padding: 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0.15, 0, 5);"
          spacing="15"
          prefWidth="900"
          VBox.vgrow="ALWAYS">

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="📖 Generated Sentence"
                   style="-fx-font-size: 16px;
                          -fx-text-fill: #f8fafc;
                          -fx-font-weight: bold;" />
            <Label fx:id="algorithmLabel" text=""
                   style="-fx-text-fill: #94a3b8;
                          -fx-font-size: 13px;
                          -fx-font-style: italic;" />
        </HBox>

        <ScrollPane fitToWidth="true" 
                    fitToHeight="true"
                    style="-fx-background: #334155; 
                           -fx-background-color: #334155;
                           -fx-border-color: #475569;
                           -fx-border-radius: 8;
                           -fx-border-width: 1;"
                    VBox.vgrow="ALWAYS">
            <VBox fx:id="sentenceContainer" spacing="10" style="-fx-padding: 15;">
                <Label text="Click a generation button above to create a sentence..."
                       wrapText="true"
                       style="-fx-text-fill: #94a3b8;
                              -fx-font-size: 14px;
                              -fx-font-style: italic;" />
            </VBox>
        </ScrollPane>

        <!-- Statistics Row -->
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label fx:id="wordCountLabel" text="Words: 0"
                   style="-fx-text-fill: #94a3b8;
                          -fx-font-size: 13px;" />
        </HBox>
    </VBox>

    <!-- Footer Navigation -->
    <HBox alignment="CENTER" spacing="10">
        <Button text="← Back to Main Menu" onAction="#goBack"
                style="-fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #f59e0b;
                       -fx-background-color: transparent;
                       -fx-border-color: #f59e0b;
                       -fx-border-radius: 6;
                       -fx-border-width: 1;
                       -fx-padding: 8 16;" />
    </HBox>
</VBox>
