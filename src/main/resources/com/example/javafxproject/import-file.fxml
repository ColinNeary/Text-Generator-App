<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<!--
    import-file.fxml
    This FXML file defines the File Import Manager interface for the Text Generator AI application.
    It provides a comprehensive file upload and management system with table display, progress indicators,
    and advanced file analysis capabilities. Supports TXT, DOCX, and PDF file formats.

    The layout uses a dark theme with blue accents and includes file selection, import tracking,
    and database integration features for text analysis and word statistics.

    Written by Arafat Khan for CS4485.OW1, Senior Project, starting September 13, 2025.
        NetID: AXK220194
        Last modified: September 28, 2025
-->

<VBox fx:id="root"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.javafxproject.ImportFileController"
      alignment="TOP_CENTER"
      spacing="25"
      prefWidth="1200"
      prefHeight="750"
      style="-fx-padding: 30 50 30 50;
             -fx-background-color: #0f172a;">

    <!-- Header Section
         Application title and description with modern typography -->
    <VBox alignment="CENTER" spacing="8">
        <Label text="📁 File Import Manager"
               style="-fx-font-size: 28px;
                      -fx-text-fill: #f8fafc;
                      -fx-font-weight: bold;
                      -fx-font-family: 'Segoe UI', 'System', sans-serif;" />
        <Label text="Upload and manage your documents with advanced text analysis"
               style="-fx-font-size: 14px;
                      -fx-text-fill: #94a3b8;
                      -fx-font-family: 'Segoe UI', 'System', sans-serif;" />
    </VBox>

    <!-- File Selection Card - More Compact
         Main file upload area with browse button and import functionality -->
    <VBox style="-fx-background-color: #1e293b;
                 -fx-background-radius: 12;
                 -fx-padding: 20;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0.15, 0, 5);"
          spacing="15"
          prefWidth="900">

        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="📂 File Selection"
                   style="-fx-font-size: 16px;
                          -fx-text-fill: #f8fafc;
                          -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <!-- Progress Indicator for import operations -->
            <ProgressIndicator fx:id="progressIndicator" visible="false"
                               style="-fx-progress-color: #10b981;
                                      -fx-pref-width: 20;
                                      -fx-pref-height: 20;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15">
            <!-- File Browse Button - Opens system file chooser -->
            <Button fx:id="chooseFileButton" text="Browse Files" onAction="#chooseFile"
                    style="-fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;
                           -fx-background-color: #3b82f6;
                           -fx-background-radius: 6;
                           -fx-padding: 10 20;" />

            <!-- Selected File Display - Shows currently selected file name -->
            <Label fx:id="selectedFileLabel" text="No file selected"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #94a3b8;
                          -fx-font-style: italic;" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Import Button - Triggers advanced file analysis and database import -->
            <Button fx:id="importButton" text="Import File with Analysis" onAction="#importFile" disable="true"
                    style="-fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;
                           -fx-background-color: #10b981;
                           -fx-background-radius: 6;
                           -fx-padding: 10 20;" />
        </HBox>

        <!-- Progress Bar Container -->
        <VBox fx:id="progressContainer" visible="false" spacing="5">
            <ProgressBar fx:id="progressBar"
                         prefWidth="Infinity"
                         prefHeight="20"
                         style="-fx-accent: #10b981;
                                -fx-control-inner-background: #334155;
                                -fx-background-radius: 6;
                                -fx-border-radius: 6;" />
            <Label fx:id="progressLabel" text=""
                   style="-fx-text-fill: #94a3b8;
                          -fx-font-size: 12px;
                          -fx-font-style: italic;" />
        </VBox>
    </VBox>

    <!-- Imported Files Section
         Table display of all previously imported files with statistics -->
    <VBox spacing="15" prefWidth="900" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="📋 Imported Files"
                   style="-fx-font-size: 18px;
                          -fx-text-fill: #f8fafc;
                          -fx-font-weight: bold;" />
            <!-- Dynamic file count display -->
            <Label fx:id="fileCountLabel" text="(0 files imported)"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #64748b;
                          -fx-font-style: italic;" />
        </HBox>

        <!-- Table Container
             Scrollable table showing imported files with actions -->
        <VBox style="-fx-background-color: #1e293b;
                     -fx-background-radius: 10;
                     -fx-border-color: #334155;
                     -fx-border-radius: 10;
                     -fx-border-width: 1;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.1, 0, 2);"
              VBox.vgrow="ALWAYS">

            <TableView fx:id="importedFilesTable"
                       style="-fx-background-color: transparent;
                              -fx-border-color: transparent;
                              -fx-table-cell-border-color: transparent;"
                       VBox.vgrow="ALWAYS">
                <columns>
                    <!-- Serial Number Column - Auto-generated sequence -->
                    <TableColumn fx:id="serialNumberColumn" prefWidth="60" />

                    <!-- File Name Column - Display original file name -->
                    <TableColumn fx:id="fileNameColumn" prefWidth="400" />

                    <!-- Word Count Column - Total words extracted from file -->
                    <TableColumn fx:id="wordCountColumn" prefWidth="150" />

                    <!-- Import Date Column - Timestamp of file import -->
                    <TableColumn fx:id="importDateColumn" prefWidth="200" />

                    <!-- Actions Column - View and delete operations -->
                    <TableColumn fx:id="actionsColumn" prefWidth="120" />
                </columns>

                <!-- Column Resize Policy - Automatic column sizing -->
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>

    <!-- Footer Navigation
         Back button to return to main menu -->
    <HBox alignment="CENTER" spacing="10">
        <Button text="← Back to Main Menu" onAction="#goBack"
                style="-fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #3b82f6;
                       -fx-background-color: transparent;
                       -fx-border-color: #3b82f6;
                       -fx-border-radius: 6;
                       -fx-border-width: 1;
                       -fx-padding: 8 16;" />
    </HBox>
</VBox>